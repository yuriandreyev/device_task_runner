# Copy to .env and set local development values before starting Django or Compose.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
POSTGRES_DB=device_task_runner
POSTGRES_USER=device_task_runner
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Agent variables must be exported in its terminal; agent does not load .env.
SERVER_URL=http://127.0.0.1:8000
DEVICE_ID=pc-42
DEVICE_TOKEN=

# Optional presence: set REDIS_URL=redis://127.0.0.1:6379/0 to enable.
REDIS_URL=
REDIS_PORT=6379
